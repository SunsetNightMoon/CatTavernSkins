# ============================================
# Minecraft Skin Server - Environment Config
# ============================================
# Primary development: Windows + SQLite
# Production: Linux + PostgreSQL (see deploy/README.md)

# ============================================
# Server
# ============================================
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ============================================
# Database
# ============================================
# DB_TYPE: sqlite (Windows dev, zero config) or postgres (Linux/production)
# For Windows development, leave DB_TYPE=sqlite (default)
# For production, set DB_TYPE=postgres and configure PostgreSQL below
DB_TYPE=sqlite

# PostgreSQL settings (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=skin_server
DB_USER=postgres
DB_PASSWORD=your_password_here

# SQLite settings (used when DB_TYPE=sqlite)
# Relative or absolute path to the database file
DB_PATH=./data/skin_server.db

# ============================================
# Redis (optional, for caching optimization)
# ============================================
# REDIS_ENABLED: true (enable Redis) or false (disable Redis, use in-memory cache)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD: leave empty if no password
REDIS_PASSWORD=

# ============================================
# SMTP (for email verification)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@example.com

# ============================================
# System
# ============================================
# Allow new user registration
ALLOW_REGISTRATION=true

# Require email verification before login
REQUIRE_EMAIL_VERIFICATION=true

# Enable local human verification (arithmetic captcha, no external dependency)
ENABLE_CAPTCHA=true

# JWT secret (used to sign sessions). Set a long random string in production.
# Leave empty in development; the setup wizard generates one automatically.
JWT_SECRET=

# ============================================
# Cloudflare Turnstile (optional, overrides the local arithmetic captcha)
# ============================================
# Leave both empty to use the built-in arithmetic captcha.
# When both are set, Turnstile is used instead.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: reject Turnstile tokens whose hostname does not match.
# Leave empty to derive the expected host from BASE_URL.
TURNSTILE_EXPECTED_HOSTNAME=

# ============================================
# OAuth - Microsoft (optional, enables "Sign in with Microsoft")
# ============================================
# Register an app at https://portal.azure.com (Microsoft Entra ID > App registrations).
# Account type: "Accounts in any organizational directory and personal Microsoft accounts"
# (this maps to MICROSOFT_TENANT_ID=common, the default).
# Redirect URI must exactly match: <OAUTH_CALLBACK_BASE_URL>/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Base URL the OAuth provider redirects back to (usually same as BASE_URL).
OAUTH_CALLBACK_BASE_URL=http://localhost:3000

# ============================================
# Storage (local disk by default, or S3-compatible object storage)
# ============================================
# STORAGE_TYPE: local (default) or s3
STORAGE_TYPE=local
# Local storage directory (used when STORAGE_TYPE=local)
UPLOAD_DIR=./uploads
# S3 settings (used when STORAGE_TYPE=s3)
# For real AWS S3, leave S3_ENDPOINT empty. For MinIO/R2, set the endpoint URL.
S3_ENDPOINT=
S3_BUCKET=skin-server
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Optional public/CDN base URL for objects. Leave empty to serve via the backend proxy.
S3_PUBLIC_URL=

# ============================================
# API Docs (optional)
# ============================================
# Enable Swagger UI at /api-docs (keep disabled in production unless needed).
ENABLE_SWAGGER=false

# ============================================
# Copyright
# ============================================
# 自定义版权标识（显示在页脚，支持 HTML）
COPYRIGHT_TEXT=© 2024 Minecraft Skin Server
# 备案信息（可选，如 ICP 备案号，留空则不显示）
COPYRIGHT_BEIAN=
# 项目版权标识（硬编码，不可通过管理面板更改）
COPYRIGHT_PROJECT=Powered by CatTavernSkins
