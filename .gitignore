# ============================================
# Minecraft Skin Server - .gitignore
# Primary development environment: Windows + SQLite
# ============================================

# Dependencies
node_modules/
frontend/node_modules/

# Environment
.env
.env.local
.env.*.local

# Database
# --- Development (SQLite) ---
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Uploads
uploads/skins/*
uploads/capes/*
!uploads/skins/.gitkeep
!uploads/capes/.gitkeep

# RSA Keys
keys/*.pem
keys/*.pub
!keys/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/
frontend/dist/
frontend/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.bak

# OS
Thumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# Windows specific
nul
CON
PRN
AUX
NUL.exe

# Testing
coverage/
.nyc_output/

# WorkBuddy / AI tools
.workbuddy/
.codebuddy/
.trae/

# AI-related plan/reports
for_AI/

